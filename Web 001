<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giấy Chứng Nhận Độc Bản - Crazy Toy</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            gold: '#f59e0b',
                            dark: '#0f172a',
                            card: '#1e293b',
                            accent: '#38bdf8'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(245, 158, 11, 0.2);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center justify-between p-4 sm:p-6 relative overflow-x-hidden">

    <!-- HIỆU ÂM THANH NỀN (LOFI CHILL) -->
    <audio id="bgMusic" loop>
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf756.mp3?filename=lofi-study-112191.mp3" type="audio/mpeg">
    </audio>

    <!-- NÚT BẬT/TẮT NHẠC NỔI GÓC MÀN HÌNH -->
    <button onclick="toggleMusic()" id="musicBtn" class="fixed top-4 right-4 z-50 glass-panel px-4 py-2 rounded-full text-brand-gold flex items-center space-x-2 shadow-lg hover:bg-slate-800 transition">
        <i id="musicIcon" class="fa-solid fa-music animate-bounce"></i>
        <span id="musicText" class="text-xs font-semibold">Bật Nhạc Chill</span>
    </button>

    <!-- KHUNG NỘI DUNG CHÍNH -->
    <main class="w-full max-w-xl mx-auto space-y-6 my-auto">
        
        <!-- HEADER THƯƠNG HIỆU -->
        <div class="text-center space-y-2">
            <div class="inline-block p-3 rounded-2xl glass-panel text-brand-gold shadow-xl mb-1">
                <i class="fa-solid fa-cube text-3xl"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-wider bg-gradient-to-r from-amber-400 via-orange-500 to-amber-200 bg-clip-text text-transparent">
                CRAZY TOY
            </h1>
            <p class="text-xs sm:text-sm text-slate-400 italic">"Biến ý tưởng thành hiện thực[span_0](start_span)"[span_0](end_span)</p>
        </div>

        <!-- THẺ GIẤY KHAI SINH ĐIỆN TỬ (CERTIFICATE) -->
        <div class="glass-panel rounded-3xl p-6 sm:p-8 shadow-2xl relative border-t-2 border-brand-gold space-y-6">
            
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-brand-gold text-slate-950 text-[10px] font-extrabold px-4 py-1 rounded-full uppercase tracking-widest shadow">
                Độc Bản 1/1 (Certificate of Authenticity)
            </div>

            <!-- HÌNH ẢNH SẢN PHẨM -->
            <div class="relative rounded-2xl overflow-hidden shadow-lg border border-slate-700 aspect-video bg-slate-900">
                <img id="prodImg" src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop" alt="Mô hình in 3D" class="w-full h-full object-cover">
                <div class="absolute bottom-2 right-2 bg-slate-900/80 backdrop-blur px-3 py-1 rounded-lg text-xs text-brand-gold font-mono" id="prodId">
                    ID: CT-DRAGON-01
                </div>
            </div>

            <!-- TÊN VÀ THÔNG TIN MÔ HÌNH -->
            <div class="text-center space-y-2">
                <h2 id="prodName" class="text-xl sm:text-2xl font-bold text-white">Rồng Thần Kim Giáp Độc Bản</h2>
                <p id="prodDesc" class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                  Tác phẩm mô hình khớp động in 3D thủ công cao cấp. Được chế tác tỉ mỉ từng đường nét, sơn phủ bảo vệ độc quyền bởi xưởng Crazy Toy.
                </p>
            </div>

            <!-- THÔNG SỐ KỸ THUẬT (GRID) -->
            <div class="grid grid-cols-2 gap-3 text-xs pt-2 border-t border-slate-700/60">
                <div class="glass-panel p-3 rounded-xl space-y-1">
                    <span class="text-slate-400 block"><i class="fa-solid fa-calendar-days text-brand-gold mr-1"></i> Ngày Xuất Xưởng</span>
                    <strong id="prodDate" class="text-slate-200">20/11/2026</strong>
                </div>
                <div class="glass-panel p-3 rounded-xl space-y-1">
                    <span class="text-slate-400 block"><i class="fa-solid fa-gears text-brand-gold mr-1"></i> Chất Liệu & Xử Lý</span>
                    <strong id="prodMaterial" class="text-slate-200">Nhựa PLA+ / Sơn Thủ Công</strong>
                </div>
            </div>

        </div>

        <!-- KHUNG VIDEO YOUTUBE QUÁ TRÌNH SẢN XUẤT -->
        <div class="glass-panel rounded-3xl p-4 sm:p-6 space-y-3">
            <h3 class="text-sm font-bold text-brand-gold flex items-center">
                <i class="fa-brands fa-youtube text-red-500 text-lg mr-2"></i> Nhật Ký Sản Xuất (Quá trình In 3D)
            </h3>
            <div class="relative w-full aspect-video rounded-xl overflow-hidden shadow border border-slate-700">
                <iframe id="prodVideo" class="w-full h-full" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
        </div>

        <!-- CÁC NÚT LIÊN KẾT CỬA HÀNG (SẼ BỔ SUNG SAU) -->
        <div class="space-y-2">
            <a href="https://shopee.vn" target="_blank" class="w-full py-3 px-4 rounded-xl glass-panel text-center font-semibold text-sm flex items-center justify-center space-x-2 hover:bg-slate-800 transition border-amber-500/30 text-amber-400">
                <i class="fa-solid fa-store"></i>
                <span>Ghé Thăm Cửa Hàng Crazy Toy</span>
            </a>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="mt-8 text-center text-xs text-slate-500 space-y-1">
        <p>© 2026 Crazy Toy Vietnam. All rights reserved.</p>
        <p class="text-[10px] text-slate-600">Được bảo vệ bằng chip NFC chính hãng độc quyền.</p>
    </footer>

    <!-- SCRIPT TÙY CHỈNH DỮ LIỆU ĐỘC BẢN THEO URL -->
    <script>
        // Cơ sở dữ liệu mẫu cho các sản phẩm độc bản khác nhau
        const database = {
            "dragon01": {
                name: "Rồng Thần Kim Giáp Độc Bản (1/1)",
                desc: "Mô hình rồng khớp động linh hoạt, in 3D tinh xảo từng lớp nhựa, đánh bóng và sơn màu thủ công tỉ mỉ.",
                img: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=800&auto=format&fit=crop",
                date: "20/11/2026",
                material: "PLA+ Cao cấp / Sơn Metallic",
                video: "https://www.youtube.com/embed/dQw4w9WgXcQ" // Thay link youtube sản xuất thực tế vào đây
            },
            "skeleton02": {
                name: "Bộ Xương Linh Hoạt Articulated Skeleton",
                desc: "Mô hình đồ chơi giải trí cử động đa khớp độc quyền từ xưởng Crazy Toy, thành quả của 18 tiếng in liên tục.",
                img: "https://images.unsplash.com/photo-1563089145-599997674d42?q=80&w=800&auto=format&fit=crop",
                date: "22/11/2026",
                material: "PETG Bền Bỉ / Khớp Lò Xo",
                video: "https://www.youtube.com/embed/dQw4w9WgXcQ"
            }
        };

        // Lấy mã sản phẩm từ đường dẫn (Ví dụ: tenmien.com/?item=skeleton02)
        const urlParams = new URLSearchParams(window.location.search);
        const itemId = urlParams.get('item') || 'dragon01'; // Mặc định là dragon01 nếu không có tham số

        // Cập nhật thông tin lên trang web nếu tồn tại trong database
        if (database[itemId]) {
            const data = database[itemId];
            document.getElementById('prodName').innerText = data.name;
            document.getElementById('prodDesc').innerText = data.desc;
            document.getElementById('prodImg').src = data.img;
            document.getElementById('prodDate').innerText = data.date;
            document.getElementById('prodMaterial').innerText = data.material;
            document.getElementById('prodVideo').src = data.video;
            document.getElementById('prodId').innerText = "ID: " + itemId.toUpperCase();
        }

        // Xử lý bật/tắt nhạc nền Lofi
        let isPlaying = false;
        const bgMusic = document.getElementById('bgMusic');
        const musicIcon = document.getElementById('musicIcon');
        const musicText = document.getElementById('musicText');

        function toggleMusic() {
            if (!isPlaying) {
                bgMusic.play();
                isPlaying = true;
                musicIcon.className = "fa-solid fa-volume-high text-emerald-400 animate-pulse";
                musicText.innerText = "Đang Phát Nhạc";
            } else {
                bgMusic.pause();
                isPlaying = false;
                musicIcon.className = "fa-solid fa-music";
                musicText.innerText = "Bật Nhạc Chill";
            }
        }
    </script>
</body>
</html>
